{
  "name": "agent-session-kit",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 ask-core/tests/*.test.mjs",
    "ask": "node ask-core/bin/ask.js",
    "ask:preflight": "node ask-core/bin/ask.js preflight",
    "ask:can-commit": "node ask-core/bin/ask.js can-commit",
    "ask:pre-commit-check": "node ask-core/bin/ask.js pre-commit-check",
    "ask:commit-msg-check": "node ask-core/bin/ask.js commit-msg-check",
    "ask:pre-push-check": "node ask-core/bin/ask.js pre-push-check",
    "session:hooks:install": "node scripts/session/installHooks.mjs",
    "session:guard:precommit": "node scripts/session/runAskCorePreCommitAdapter.mjs",
    "session:guard:commitmsg": "node scripts/session/runAskCoreCommitMsgAdapter.mjs",
    "session:guard:prepush": "node scripts/session/runAskCorePrePushAdapter.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
